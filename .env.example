# Copy to .env.local for local dev, or set in Vercel → Settings → Environment Variables

# Optional: for scripts/deploy-vercel.ps1 one-click deploy
# VERCEL_TOKEN=

SPEECHMATICS_API_KEY=
GEMINI_API_KEY=

# Optional (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Local: upload via http://localhost:3010 setup panel, or:
# YTDLP_COOKIES_FILE=config/youtube-cookies.txt

# Vercel (required for reliable YouTube access): paste entire Netscape cookies file
# YTDLP_COOKIES=

# Vercel only: URL of same app deployed on Render (Docker) for full YouTube paste-link
# TRANSCRIBE_SERVICE_URL=https://your-app.onrender.com

# Optional: comma-separated Invidious instances for caption fallback
# INVIDIOUS_INSTANCES=https://inv.nadeko.net

# Optional override for yt-dlp binary (local debugging)
# YTDLP_PATH=vendor/yt-dlp
